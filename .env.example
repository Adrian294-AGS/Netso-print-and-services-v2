# Copy to .env locally. Supply credentials through your deployment secret manager.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=netso_prints
MYSQL_USER=netso_app
MYSQL_PASSWORD=replace-with-a-strong-secret
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000

MONGODB_URI=mongodb://127.0.0.1:27017/netso_messages_logs
MONGODB_TLS=false
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Authentication and Google OAuth
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Private Backblaze B2 bucket (S3-compatible API)
B2_REGION=replace-with-b2-region
B2_KEY_ID=replace-with-b2-application-key-id
B2_APPLICATION_KEY=replace-with-b2-application-key
B2_BUCKET_NAME=replace-with-private-bucket-name
